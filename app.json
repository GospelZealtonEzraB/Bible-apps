{
  "expo": {
    "name": "Versed",
    "slug": "engraved",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "engraved",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/2ce595e5-eafc-4883-8bfa-7a1f02638d78"
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B1220"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.engraved.app"
    },
    "android": {
      "package": "com.engraved.app",
      "allowBackup": false,
      "adaptiveIcon": {
        "backgroundColor": "#0B1220",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#7C9CF5"
        }
      ]
    ],
    "extra": {
      "defaultServerUrl": "https://biblememory.biblememory.workers.dev",
      "appSecret": "",
      "eas": {
        "projectId": "2ce595e5-eafc-4883-8bfa-7a1f02638d78"
      }
    }
  }
}
